# Copy to .env (never commit .env). Everything is optional for local development.

# --- Server -------------------------------------------------------------
# NODE_ENV=development
# PORT=4000
# HOST=0.0.0.0
# API_PUBLIC_URL=http://localhost:4000
# Behind a proxy / load balancer (so rate limits see real client IPs):
# TRUST_PROXY=true

# --- Database -----------------------------------------------------------
# Empty = embedded local Postgres (PGlite) in backend/.data/pglite.
# Production: any Postgres, e.g. Neon, Supabase, AWS RDS.
# DATABASE_URL=postgres://user:password@host:5432/driveflow

# --- Security -----------------------------------------------------------
# 32 random bytes, base64. Required in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# TOKEN_ENCRYPTION_KEY=
# SESSION_DAYS=60
# Web origins allowed to call the API (comma-separated). Required in production.
# CORS_ORIGINS=https://driveflow.app,https://app.driveflow.app
# RATE_LIMIT=true

# --- Development stand-ins ---------------------------------------------
# On by default outside production: mock Google sign-in ("dev:<email>:<Name>"),
# the sample Drive (the app's own photos) and GET /dev/outbox. Must be false in production.
# DEV_MOCKS=true
# SAMPLE_PHOTOS_DIR=../frontend/assets/images
# Demo account made by `npm run seed`:
# DEMO_EMAIL=demo@driveflow.local
# DEMO_PASSWORD=driveflow-demo-1

# --- Email (verification + password reset codes) -----------------------
# console = print codes in the server log (development). resend = send for real.
# EMAIL_PROVIDER=console
# EMAIL_FROM=DriveFlow <no-reply@driveflow.app>
# RESEND_API_KEY=
# SUPPORT_EMAIL=support@yourcompany.com

# --- Share links --------------------------------------------------------
# SHARE_BASE_URL=https://driveflow.app/p/

# --- Chat assistant -----------------------------------------------------
# Claude API key: the chat then reads free-form requests with Claude. Without it, a built-in
# rule-based reader is used. ASSISTANT_MODEL defaults to claude-opus-5-5.
# ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-opus-5-5

# --- Background sync and push notifications -----------------------------
# How often each connected Drive folder is re-synced, in minutes (0 = off).
# SYNC_INTERVAL_MINUTES=30
# PUSH_ENABLED=true
# Only needed if push security is turned on for your Expo project:
# EXPO_ACCESS_TOKEN=

# --- Google sign-in (required in production) ------------------------------
# OAuth client IDs whose ID tokens are accepted, comma-separated. The app's native sign-in uses the Web client ID.
# GOOGLE_CLIENT_IDS=xxxx.apps.googleusercontent.com,yyyy.apps.googleusercontent.com

# --- Google Drive, read-only (required in production) --------------------
# The "Web application" OAuth client: swaps the app's server auth code for Drive access.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
