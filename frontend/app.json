{
  "expo": {
    "name": "DriveFlow",
    "slug": "driveflow",
    "owner": "techgylink",
    "scheme": "driveflow",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/e9f116ee-d84a-415f-b948-4d7b721e1c70"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.techgylink.driveflow",
      "associatedDomains": [
        "applinks:driveflow.techgylink.com"
      ]
    },
    "android": {
      "package": "com.techgylink.driveflow",
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E9ECFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "driveflow.techgylink.com",
              "pathPrefix": "/p/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-image",
      [
        "expo-notifications",
        {
          "color": "#0022FF"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-blue.png",
          "imageWidth": 96,
          "resizeMode": "contain",
          "backgroundColor": "#F3F4F8"
        }
      ],
      "expo-sharing",
      "expo-asset",
      "./plugins/withDebugKeystore",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e9f116ee-d84a-415f-b948-4d7b721e1c70"
      }
    }
  }
}
